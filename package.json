{
  "name": "forgeworks-erp-backend",
  "version": "1.1.0",
  "description": "Real backend API for the Forgeworks ERP prototype (steel & wood furniture manufacturing).",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node -e \"require('./src/db').pool.query(require('fs').readFileSync('./src/schema.sql').toString()).then(()=>{console.log('Schema applied');process.exit(0)}).catch(e=>{console.error(e);process.exit(1)})\"",
    "seed": "node src/seed.js",
    "seed:prod": "node src/seed-production.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
