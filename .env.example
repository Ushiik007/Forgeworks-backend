# PostgreSQL connection string
# Local example:   postgres://postgres:postgres@localhost:5432/forgeworks
# Render/Railway/Supabase will give you this string directly.
DATABASE_URL=postgresql://user:password@localhost:5432/forgeworks

# Secret used to sign JWTs — change this to a long random string in production
JWT_SECRET=your_super_long_random_secret_here

# Port the API listens on
PORT=4000

# Used only by `npm run seed` to create the first Admin account
SEED_ADMIN_NAME=Admin User
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=ChangeMeImmediately123!

# Comma-separated list of origins allowed to call this API (your frontend URL)
CORS_ORIGIN=http://localhost:5173